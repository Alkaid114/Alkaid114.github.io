---
import { getLocale, LOCALE_META } from "../i18n/ui";

interface Props {
	date: Date;
}

const { date } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(LOCALE_META[locale].dateLocale, {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		})
	}
</time>
