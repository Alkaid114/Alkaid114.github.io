---
interface Props {
	date: Date;
}

const { date } = Astro.props;
const options: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
};
const zhDate = date.toLocaleDateString("zh-CN", options);
const enDate = date.toLocaleDateString("en-US", options);
---

<time datetime={date.toISOString()}
	><span data-locale-text="zh" lang="zh-CN">{zhDate}</span><span
		data-locale-text="en"
		lang="en">{enDate}</span></time
>
