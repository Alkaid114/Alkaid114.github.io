---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { Page } from "astro";
import { categoryHref, categoryLookup, resolveCategory } from "../utils/categories";
import { excerptFromBody } from "../utils/excerpt";
import FormattedDate from "./FormattedDate.astro";
import Pagination from "./Pagination.astro";

interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;

const lookup = categoryLookup(await getCollection("posts"));

const posts = page.data.map((post) => {
	const { name: category, slug } = resolveCategory(post.data.category, lookup);
	return {
		...post,
		excerpt: excerptFromBody(post.body) || post.data.description,
		category,
		categoryUrl: categoryHref(slug),
	};
});

const currentPath = page.url.current;
const baseHref =
	page.currentPage > 1
		? currentPath.replace(new RegExp(`/${page.currentPage}/$`), "/")
		: currentPath;
const pageHref = (n: number) => (n === 1 ? baseHref : `${baseHref}${n}/`);
---

<ul class="m-0 mt-s list-none divide-y divide-secondary-200 p-0 dark:divide-secondary-800">
	{
		posts.map((post) => (
			<li class="group relative flex flex-col gap-3xs py-s sm:flex-row sm:items-baseline sm:justify-between sm:gap-m">
				<span class="flex min-w-0 flex-col gap-3xs">
					<a
						href={`/posts/${post.id}/`}
						class="text-fluid-m font-bold text-primary-950 no-underline transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-primary-600 dark:text-primary-50 dark:group-hover:text-primary-300"
					>
						{post.data.title}
					</a>
					<span class="line-clamp-2 text-fluid-xs mb-xs mt-xs text-secondary-600 dark:text-secondary-400">
						{post.excerpt}
					</span>
				</span>
				<span class="flex shrink-0 items-center gap-s text-fluid-xs">
					<a
						href={post.categoryUrl}
						class="relative z-10 font-mono text-primary-600 no-underline hover:underline dark:text-primary-300"
					>
						#{post.category}
					</a>
					<span class="font-mono text-secondary-500 dark:text-secondary-400">
						<FormattedDate date={post.data.published} />
					</span>
				</span>
			</li>
		))
	}
</ul>

{
	page.lastPage > 1 && (
		<>
			<Pagination {page} radius={1} href={pageHref} compact class="mt-l flex sm:hidden" />
			<Pagination {page} radius={2} href={pageHref} class="mt-l hidden sm:flex" />
		</>
	)
}
