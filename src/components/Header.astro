---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="border-b border-secondary-200 dark:border-secondary-800 bg-secondary-50 dark:bg-secondary-900 px-s">
	<nav class="flex items-center justify-around">
		<h2 class="m-0">
			<a href="/" class="inline-block whitespace-nowrap px-2xs py-s text-secondary-950 dark:text-secondary-50 no-underline">{SITE_TITLE}</a>
		</h2>
		<div class="flex">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>