---
import { NICKNAME } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Translated from "./Translated.astro";
---

<header
	class="border-b border-secondary-200 dark:border-secondary-800 bg-secondary-50 dark:bg-secondary-900 px-s"
>
	<nav
		class="mx-auto flex w-full max-w-240 flex-wrap items-center justify-center gap-x-s gap-y-3xs sm:justify-between"
	>
		<h2 class="m-0">
			<a
				href="/"
				class="inline-block whitespace-nowrap px-2xs py-s text-secondary-950 dark:text-secondary-50 no-underline font-mono font-bold text-2xl"
				>{NICKNAME}<span
					class="inline-block w-3 h-5.5 ml-1 mb-1 bg-current animate-blink align-middle text-secondary-950 dark:text-secondary-50"
				></span></a
			>
		</h2>
		<div class="flex flex-wrap items-center justify-center gap-x-3xs">
			<HeaderLink href="/" iconInactive="bi:archive" iconActive="bi:archive-fill"
				><Translated name="home" /></HeaderLink
			>
			<HeaderLink href="/categories" iconInactive="bi:folder" iconActive="bi:folder-fill"
				><Translated name="categories" /></HeaderLink
			>
			<HeaderLink href="/friends" iconInactive="bi:people" iconActive="bi:people-fill"
				><Translated name="friendLinks" /></HeaderLink
			>
			<HeaderLink href="/about"><Translated name="about" /></HeaderLink>
		</div>
	</nav>
</header>
