---
import { NICKNAME } from "../consts";
import { t } from "../i18n/ui";
import HeaderLink from "./HeaderLink.astro";
---

<header
	class="border-b border-secondary-200 dark:border-secondary-800 bg-secondary-50 dark:bg-secondary-900 px-s"
>
	<nav class="flex items-center justify-around">
		<h2 class="m-0">
			<a
				href="/"
				class="inline-block whitespace-nowrap px-2xs py-s text-secondary-950 dark:text-secondary-50 no-underline font-mono font-bold text-2xl"
				>{NICKNAME}<span
					class="inline-block w-3 h-5.5 ml-1 mb-1 bg-current animate-blink align-middle text-secondary-950 dark:text-secondary-50"
				></span></a
			>
		</h2>
		<div class="flex items-center">
			<HeaderLink href="/" data-i18n="home">{t("zh", "home")}</HeaderLink>
			<HeaderLink href="/about" data-i18n="about">{t("zh", "about")}</HeaderLink>
			<button
				type="button"
				data-locale-toggle
				aria-label={t("zh", "switchLanguageLabel")}
				class="mx-1 inline-flex cursor-pointer items-center rounded border border-secondary-300 px-2xs py-3xs font-mono text-fluid-xs text-secondary-700 transition-colors hover:border-primary-600 hover:text-primary-600 dark:border-secondary-700 dark:text-secondary-300 dark:hover:border-primary-300 dark:hover:text-primary-300"
			>
				{t("zh", "switchLanguage")}
			</button>
		</div>
	</nav>
</header>
