---
import type { HTMLAttributes } from "astro/types";
import { stripLocale } from "../i18n/ui";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const normalize = (path: string) => `/${path.replace(/^\/+|\/+$/g, "")}`;

const current = normalize(Astro.url.pathname);
const base = normalize(stripLocale(Astro.url.pathname));
const target = normalize(stripLocale(href ?? "/"));
const subpath = base.match(/[^/]+/g);
const isActive =
	current === normalize(href ?? "/") ||
	base === target ||
	normalize(`/${subpath?.[0] ?? ""}`) === target;
---

<a
	href={href}
	class:list={[
		"inline-block whitespace-nowrap border-b-4 border-transparent px-1.5 py-s sm:px-2xs text-secondary-950 dark:text-secondary-50 no-underline transition-colors hover:text-primary-600 dark:hover:text-primary-300",
		isActive && "border-primary-600 dark:border-primary-300 font-bold underline",
		className,
	]}
	{...props}
>
	<slot />
</a>
