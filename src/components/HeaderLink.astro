---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> & { iconInactive?: string; iconActive?: string };

const { href, iconInactive, iconActive, class: className, ...props } = Astro.props;

const normalize = (path: string) => `/${path.replace(/^\/+|\/+$/g, "")}`;

const current = normalize(Astro.url.pathname);
const subpath = current.match(/[^/]+/g);
const hrefString = href ? String(href) : "";
const isActive =
	current === normalize(hrefString ?? "/") ||
	normalize(`/${subpath?.[0] ?? ""}`) === normalize(hrefString ?? "/");
---

<a
	href={href}
	class:list={[
		"flex items-center whitespace-nowrap border-b-4 border-transparent px-1.5 py-s sm:px-2xs text-secondary-950 dark:text-secondary-50 no-underline transition-colors hover:text-primary-600 dark:hover:text-primary-300",
		isActive && "border-primary-600 dark:border-primary-300 font-bold underline",
		className,
	]}
	{...props}
>
	{
		(iconInactive || iconActive) && (
			<Icon name={isActive ? iconActive || iconInactive : iconInactive} class="mr-2 size-4" />
		)
	}
	<slot />
</a>
