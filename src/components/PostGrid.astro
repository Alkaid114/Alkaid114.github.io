---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { categoryHref, categoryLookup, resolveCategory } from "../utils/categories";
import FormattedDate from "./FormattedDate.astro";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const lookup = categoryLookup(await getCollection("posts"));
---

<ul class="m-0 grid list-none grid-cols-1 gap-l p-0 md:grid-cols-2">
	{
		posts.map((post, index) => {
			const { name: category, slug } = resolveCategory(post.data.category, lookup);
			const categoryUrl = categoryHref(slug);

			return (
				<li
					class:list={[
						"group relative",
						index === 0 ? "text-center md:col-span-2" : "max-md:text-center",
					]}
				>
					{post.data.heroImage && (
						<Image
							class="mb-2xs w-full rounded-xl transition duration-200 group-hover:shadow-box"
							width={720}
							height={360}
							src={post.data.heroImage}
							alt=""
						/>
					)}
					<h4
						class:list={[
							"m-0 leading-none text-secondary-950 dark:text-secondary-50 transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-300",
							index === 0 ? "text-fluid-2xl" : "text-fluid-l",
						]}
					>
						<a
							href={`/posts/${post.id}/`}
							class="text-inherit no-underline after:absolute after:inset-0 after:content-['']"
						>
							{post.data.title}
						</a>
					</h4>
					<p class="m-0 text-fluid-xs text-secondary-700 dark:text-secondary-300">
						<a
							href={categoryUrl}
							class="relative z-10 font-mono text-primary-600 no-underline hover:underline dark:text-primary-300"
						>
							#{category}
						</a>
						<span class="ml-2 font-mono text-secondary-500 dark:text-secondary-400">
							<FormattedDate date={post.data.published} />
						</span>
					</p>
				</li>
			);
		})
	}
</ul>
