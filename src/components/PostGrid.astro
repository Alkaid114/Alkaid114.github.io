---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<ul class="m-0 grid list-none grid-cols-1 gap-l p-0 md:grid-cols-2">
	{
		posts.map((post, index) => (
			<li class:list={[index === 0 ? "text-center md:col-span-2" : "max-md:text-center"]}>
				<a
					href={`/posts/${post.id}/`}
					class="group block no-underline transition duration-200"
				>
					{post.data.heroImage && (
						<Image
							class="mb-2xs w-full rounded-xl transition duration-200 group-hover:shadow-box"
							width={720}
							height={360}
							src={post.data.heroImage}
							alt=""
						/>
					)}
					<h4
						class:list={[
							"m-0 leading-none text-secondary-950 dark:text-secondary-50 transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-300",
							index === 0 ? "text-fluid-2xl" : "text-fluid-l",
						]}
					>
						{post.data.title}
					</h4>
					<p class="m-0 text-fluid-xs text-secondary-700 transition-colors group-hover:text-primary-600 dark:text-secondary-300 dark:group-hover:text-primary-300">
						<FormattedDate date={post.data.published} />
					</p>
				</a>
			</li>
		))
	}
</ul>
