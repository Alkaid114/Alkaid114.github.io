---
import { execSync } from "node:child_process";
import { Icon } from "astro-icon/components";
import { GIT_REPO_COMMIT_HASH_URL, NICKNAME } from "../consts";

const today = new Date();
const linkClass = "text-primary-600 dark:text-primary-300 hover:underline mx-2 whitespace-nowrap";

const fullHash =
	process.env.COMMIT_HASH || execSync("git rev-parse HEAD").toString().trim() || "unknown";
const shortHash = fullHash.substring(0, 7);
const commitUrl = GIT_REPO_COMMIT_HASH_URL.replace("{}", fullHash);
---

<footer
	class="px-s pt-l pb-3xl text-center text-secondary-700 dark:text-secondary-300 font-mono text-m"
>
	<div class="flex items-center justify-center gap-1 mb-2">
		<span>Source</span>
		<a href={commitUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
			{shortHash}</a
		>
		<Icon name="fa6-regular:copyright" class="w-4 h-4" />
		<span>{today.getFullYear()} {NICKNAME}.</span>
		<a
			href="/rss.xml"
			target="_blank"
			rel="noopener noreferrer"
			class={`${linkClass} flex items-center`}
		>
			<Icon name="bi:rss-fill" class="size-6 inline-block" />
			<span class="ml-1">RSS</span>
		</a>
	</div>

	<p class="leading-relaxed max-w-prose mx-auto">
		Code licensed under
		<a
			href="https://opensource.org/licenses/Apache-2.0"
			target="_blank"
			rel="noopener noreferrer"
			class={linkClass}>Apache License 2.0</a
		>
	</p>
	<p class="leading-relaxed max-w-prose mx-auto">
		Content licensed under
		<a
			href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
			target="_blank"
			rel="noopener noreferrer"
			class={linkClass}>CC BY-NC-SA 4.0</a
		>
	</p>
	<p class="leading-relaxed max-w-prose mx-auto">Except where otherwise noted.</p>

	<p class="leading-relaxed mt-s">
		Built with
		<a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class={linkClass}
			>Astro</a
		>
		and
		<a
			href="https://tailwindcss.com/"
			target="_blank"
			rel="noopener noreferrer"
			class={linkClass}>Tailwind CSS</a
		>
	</p>
</footer>
