---
import { Icon } from "astro-icon/components";
import avatar from "../assets/avatar.png";
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";
import Avatar from "./Avatar.astro";
---

<div class="max-w-none prose-theme prose">
	<div
		class="flex flex-col justify-center items-center gap-s text-center sm:flex-row sm:items-center sm:gap-m sm:text-left pt-m sm:pt-0"
	>
		<Avatar src={avatar} alt="Avatar" />
		<div class="w-full sm:w-auto m-5">
			<h1 class="m-0 font-mono font-bold sm:text-fluid-2xl text-fluid-xl" data-drag-title>
				{
					Array.from(SITE_TITLE).map((char) => (
						<span class="inline-block cursor-grab touch-pan-y select-none" data-char>
							{char === " " ? "\u00A0" : char}
						</span>
					))
				}
			</h1>
			<div class="flex justify-center sm:justify-start gap-m sm:pl-10">
				{
					SOCIAL_LINKS.map(({ href, label, icon }) => (
						<a
							href={href}
							class="inline-flex dark:text-secondary-200 text-secondary-800 hover:text-primary-400"
						>
							<Icon name={icon} class="size-8" aria-hidden="true" />
							<span class="sr-only">{label}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</div>

<script>
	import "../scripts/drag-title";
</script>
