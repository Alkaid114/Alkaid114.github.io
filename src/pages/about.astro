---
import AboutHeroImage from "../assets/blog-placeholder-about.jpg";
import AboutContent from "../components/AboutContent.astro";
import { DEFAULT_LOCALE, t } from "../i18n/ui";
import Layout from "../layouts/BlogPost.astro";
---

<Layout
	title={t(DEFAULT_LOCALE, "aboutTitle")}
	description={t(DEFAULT_LOCALE, "aboutDescription")}
	titleKey="aboutTitle"
	published={new Date("August 08 2021")}
	heroImage={AboutHeroImage}
	draft={false}
>
	<AboutContent />
</Layout>
