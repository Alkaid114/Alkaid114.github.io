---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body
		class="bg-linear-to-b from-muted-light/50 to-white bg-no-repeat bg-size-[100%_600px] font-atkinson text-xl leading-[1.7] wrap-break-word text-muted-dark max-md:text-lg"
	>
		<Header />
		<main class="mx-auto w-240 max-w-[calc(100%-2em)] px-5 py-15 max-md:px-4 max-md:py-4">
			<section>
				<ul class="m-0 flex list-none flex-wrap gap-8 p-0 max-md:gap-2">
					{
						posts.map((post, index) => (
							<li
								class:list={[
									index === 0
										? 'mb-4 w-full text-center max-md:mb-0'
										: 'w-[calc(50%-1rem)] max-md:w-full max-md:text-center',
								]}
							>
								<a href={`/blog/${post.id}/`} class="group block no-underline transition duration-200">
									{post.data.heroImage && (
										<Image
											class="mb-2 w-full rounded-xl transition duration-200 group-hover:shadow-box"
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
										/>
									)}
									<h4
										class:list={[
											'm-0 leading-none text-ink transition-colors group-hover:text-accent',
											index === 0 ? 'text-[2.369em] max-md:text-[1.563em]' : 'text-[1.563em]',
										]}
									>
										{post.data.title}
									</h4>
									<p class="m-0 text-muted transition-colors group-hover:text-accent">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
