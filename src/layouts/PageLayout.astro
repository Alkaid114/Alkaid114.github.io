---
import BaseHead from "../components/BaseHead.astro";
import FloatingActions from "../components/FloatingActions.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { UIKey } from "../i18n/ui";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
	titleKey?: UIKey;
	titleSuffix?: string;
}

const { title, description, titleKey, titleSuffix } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scheme-light-dark">
	<head>
		<BaseHead {title} {description} {titleKey} {titleSuffix} />
		<ClientRouter />
	</head>
	<body
		class="relative flex min-h-dvh flex-col bg-secondary-100 dark:bg-secondary-950 bg-no-repeat bg-size-[100%_600px] font-sans text-fluid-s wrap-break-word text-secondary-950 dark:text-secondary-50"
	>
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 -z-10 overflow-hidden text-secondary-400/40 dark:text-secondary-600/40"
		>
			<div class="absolute -inset-1/2 rotate-[8deg]">
				<div class="h-full w-full animate-grid-scroll motion-reduce:animate-none">
					<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
						<defs>
							<pattern
								id="dashed-grid"
								width="72"
								height="72"
								patternUnits="userSpaceOnUse"
							>
								<path
									d="M72 0H0V72"
									fill="none"
									stroke="currentColor"
									stroke-width="1"
									stroke-dasharray="6 6"></path>
							</pattern>
						</defs>
						<rect width="100%" height="100%" fill="url(#dashed-grid)"></rect>
					</svg>
				</div>
			</div>
		</div>

		<Header />
		<main class="flex flex-1 justify-center">
			<div class="w-full max-w-240 bg-secondary-50 p-s sm:p-m dark:bg-secondary-900">
				<slot />
			</div>
		</main>
		<Footer />
		<FloatingActions />
		<script>
			import "../scripts/i18n";
		</script>
	</body>
</html>
