---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="scheme-light-dark">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body
		class="bg-secondary-50 dark:bg-secondary-950 bg-linear-to-b from-secondary-100/50 dark:from-secondary-800/50 to-secondary-50 dark:to-secondary-950 bg-no-repeat bg-size-[100%_600px] font-atkinson text-fluid-s wrap-break-word text-secondary-950 dark:text-secondary-50"
	>
		<Header />
		<main class="m-0 w-full max-w-full">
			<article>
				<div class="w-full">
					{
						heroImage && (
							<Image
								class="mx-auto block w-full rounded-xl shadow-box"
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						)
					}
				</div>
				<div class="mx-auto w-full max-w-180 px-s py-s">
					<div class="mb-s border-b border-secondary-200 py-s text-center leading-none dark:border-secondary-800">
						<div class="mb-2xs text-secondary-700 dark:text-secondary-300">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 class="m-0 text-fluid-3xl text-secondary-950 dark:text-secondary-50">{title}</h1>
					</div>
					<div
						class="prose prose-xl prose-theme max-w-none text-fluid-s prose-h1:text-fluid-2xl prose-h2:text-fluid-xl prose-h3:text-fluid-l prose-h4:text-fluid-m prose-h5:text-fluid-s prose-h6:text-fluid-xs"
					>
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
