---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import FormattedDate from "../components/FormattedDate.astro";
import Translated from "../components/Translated.astro";
import type { UIKey } from "../i18n/ui";
import PageLayout from "./PageLayout.astro";
import { NICKNAME } from "../consts";

type Props = CollectionEntry<"posts">["data"] & { titleKey?: UIKey };

const { title, description, published, updatedDate, heroImage, license, author, titleKey } =
	Astro.props;
---

<PageLayout {title} description={description} {titleKey}>
	<article>
		<div class="w-full">
			{
				heroImage && (
					<Image
						class="mx-auto block w-full rounded-xl shadow-box"
						width={1020}
						height={510}
						src={heroImage}
						alt=""
					/>
				)
			}
		</div>
		<div class="mx-auto w-full max-w-220 px-s py-s">
			<div
				class="mb-s border-b border-secondary-200 py-s text-center leading-none dark:border-secondary-800"
			>
				<div class="mb-2xs flex-col flex text-secondary-700 dark:text-secondary-300 gap-2">
					<FormattedDate date={published} />
					{
						updatedDate && (
							<div class="italic">
								<Translated name="lastUpdated" />{" "}
								<FormattedDate date={updatedDate} />
							</div>
						)
					}
					<span>{author || NICKNAME}</span>
					{
						license && (
							<div class="flex flex-col items-center justify-center bg-[#D37D43] w-full min-h-24 mb-s text-fluid-s text-secondary-900 font-sans font-extrabold">
								<div class="flex items-center w-full pt-2 pb-2">
									<Icon
										name="carbon:warning-hex-filled"
										class="shrink-0 ml-m size-12"
									/>
									<div class="flex flex-col flex-1 text-left ml-4">
										<p>
											<Translated name="licenseCaution" />{" "}
											{license.url ? (
												<a href={license.url} class="underline">
													{license.name}
												</a>
											) : (
												<span class="underline decoration-dashed decoration-1 underline-offset-4">
													{license.name}
												</span>
											)}
										</p>
										<p class="text-fluid-xs font-normal">
											<Translated name={license.url ? "licenseWithUrl" : "licenseNoUrl"} />
										</p>
									</div>
								</div>
							</div>
						)
					}
				</div>
				<h1 class="m-0 text-fluid-3xl text-secondary-950 dark:text-secondary-50">
					{titleKey ? <Translated name={titleKey} /> : title}
				</h1>
			</div>
			<div
				class="prose prose-xl prose-theme max-w-none text-fluid-s prose-h1:text-fluid-2xl prose-h2:text-fluid-xl prose-h3:text-fluid-l prose-h4:text-fluid-m prose-h5:text-fluid-s prose-h6:text-fluid-xs"
			>
				<slot />
			</div>
		</div>
	</article>
</PageLayout>
