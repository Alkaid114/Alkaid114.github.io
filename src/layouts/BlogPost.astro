---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="scheme-light-dark">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body
		class="bg-secondary-50 dark:bg-secondary-950 bg-linear-to-b from-secondary-100/50 dark:from-secondary-800/50 to-secondary-50 dark:to-secondary-950 bg-no-repeat bg-size-[100%_600px] font-atkinson text-xl leading-[1.7] wrap-break-word text-secondary-950 dark:text-secondary-50 max-md:text-lg"
	>
		<Header />
		<main class="m-0 w-full max-w-full">
			<article>
				<div class="w-full">
					{
						heroImage && (
							<Image
								class="mx-auto block w-full rounded-xl shadow-box"
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						)
					}
				</div>
				<div class="mx-auto w-180 max-w-[calc(100%-2em)] px-5 py-5">
					<div class="mb-5 border-b border-secondary-200 dark:border-secondary-800 py-5 text-center leading-none">
						<div class="mb-2.5 text-secondary-700 dark:text-secondary-300">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 class="m-0 text-[3.052em] leading-tight text-secondary-950 dark:text-secondary-50">{title}</h1>
					</div>
					<div class="prose prose-xl prose-theme max-w-none">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
